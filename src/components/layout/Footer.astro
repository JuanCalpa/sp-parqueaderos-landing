---
import { siteConfig, navLinks } from '../../data/siteData';
---

<footer class="border-t border-slate-800 bg-slate-950 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="flex items-center gap-2 text-lg font-bold text-white">
        <span class="flex h-7 w-7 items-center justify-center rounded-md bg-amber-400 text-xs font-black text-slate-950">
          SP
        </span>
        <span>{siteConfig.name}</span>
      </div>

      <ul class="flex flex-wrap justify-center gap-6 text-sm text-slate-400">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-amber-400 transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <p class="text-xs text-slate-500">
        &copy; {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>
