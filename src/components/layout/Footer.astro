---
import { siteConfig, navLinks } from '../../data/siteData';
import WhatsAppButton from '../ui/WhatsAppButton.astro';

const whatsappNumber = siteConfig.phone.replace(/[^0-9]/g, '');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola SP Parqueaderos, quiero más información sobre sus servicios.')}`;
---

<footer class="border-t border-slate-800 bg-slate-950 pt-16 pb-12 text-slate-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Column 1: Brand & Trust -->
      <div class="space-y-4">
        <a
          href="#inicio"
          class="inline-flex items-center gap-3 text-lg font-bold text-white cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-400/60 rounded-lg"
        >
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-400 text-sm font-black text-slate-950">
            SP
          </span>
          <span>{siteConfig.name}</span>
        </a>
        <p class="text-sm leading-relaxed text-slate-400">
          {siteConfig.description}
        </p>
        <div class="flex items-center gap-2 pt-1 text-xs font-medium text-emerald-400">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
          <span>Operación vigilada 24/7 con póliza activa</span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Navegación
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-slate-400 transition-colors duration-200 hover:text-amber-400 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-400/60 rounded"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Services & Schedules -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Servicios y Horarios
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-slate-400">
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            <span>Parqueo por Horas y Fracción</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            <span>Mensualidades 24/7 Autos y Motos</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
            <span>Convenios Corporativos B2B</span>
          </li>
          <li class="pt-2 text-xs text-slate-300">
            <strong class="text-amber-400 block">Horario de Atención:</strong>
            Lunes a Domingo — Abierto 24 Horas
          </li>
        </ul>
      </div>

      <!-- Column 4: Direct Contact & WhatsApp -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">
          Atención Directa
        </h3>
        <ul class="mt-4 space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>{siteConfig.address}</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="h-4 w-4 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <a href={`tel:${siteConfig.phone}`} class="hover:text-amber-400 transition-colors duration-200 cursor-pointer">
              {siteConfig.phone}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="h-4 w-4 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-amber-400 transition-colors duration-200 cursor-pointer">
              {siteConfig.email}
            </a>
          </li>
        </ul>

        <div class="mt-5">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-2.5 text-xs font-semibold text-emerald-300 transition-colors duration-200 hover:bg-emerald-500 hover:text-slate-950 cursor-pointer focus:outline-none focus:ring-2 focus:ring-emerald-400/60"
          >
            <span>Atención por WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Legal & Payment Badges -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800/80 pt-8 text-xs text-slate-400 sm:flex-row">
      <p>
        &copy; {new Date().getFullYear()} {siteConfig.name}. Todos los derechos reservados.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <span class="rounded-md border border-slate-800 bg-slate-900 px-2.5 py-1 text-slate-300">
          Facturación Electrónica DIAN
        </span>
        <span class="rounded-md border border-slate-800 bg-slate-900 px-2.5 py-1 text-slate-300">
          Pagos PSE / Tarjetas / Efectivo
        </span>
      </div>
    </div>
  </div>

  <!-- Floating WhatsApp Widget -->
  <WhatsAppButton />
</footer>
