---
import { siteConfig } from '../../data/siteData';

const whatsappNumber = siteConfig.phone.replace(/[^0-9]/g, '');
const demoWhatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola Sistemas Palacios, quiero probar la demo de SP Parqueaderos.')}`;

const menuItems = [
  { label: 'Inicio', href: '#inicio', active: true },
  { label: 'Módulos', href: '#servicios', active: false },
  { label: 'Solución Web & Móvil', href: '#beneficios', active: false },
  { label: 'WhatsApp & POS', href: '#whatsapp-pos', active: false },
  { label: 'Planes', href: '#tarifas', active: false },
];
---

<header id="sp-navbar" class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md shadow-xs">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
    <!-- Brand Logo: SP PARQUEADEROS / SISTEMAS PALACIOS -->
    <a
      href="#inicio"
      class="nav-brand group flex items-center gap-3.5 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#B91C1C]/50 rounded-xl"
    >
      <img
        src="/logo-sistemas-palacios.webp"
        alt="Logo Sistemas Palacios - SP Parqueaderos"
        width="136"
        height="44"
        class="h-11 w-auto shrink-0 object-contain transition-opacity duration-200 group-hover:opacity-90"
      />
      <div class="flex flex-col">
        <span class="text-lg font-extrabold tracking-tight text-slate-900 leading-tight">
          SP PARQUEADEROS
        </span>
        <span class="text-[11px] font-bold tracking-[0.08em] text-[#B91C1C] uppercase leading-tight">
          SISTEMAS PALACIOS
        </span>
      </div>
    </a>

    <!-- Center Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-7" aria-label="Navegación principal">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'nav-item text-sm font-medium transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#B91C1C]/40 rounded px-1 py-1',
            item.active
              ? 'font-semibold text-[#B91C1C]'
              : 'text-[#6B5B57] hover:text-[#B91C1C]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right CTA: Probar Demo (without Iniciar Sesión) -->
    <div class="nav-cta hidden lg:flex items-center">
      <a
        href={demoWhatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-[#B80D14] px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:bg-[#990B11] hover:shadow-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#B80D14]/50 focus:ring-offset-2"
      >
        <span>Probar Demo</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 transition-colors duration-200 hover:border-[#B91C1C] hover:text-[#B91C1C] lg:hidden cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#B91C1C]/40"
    >
      <svg id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <svg id="menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 lg:hidden shadow-lg"
  >
    <nav class="flex flex-col space-y-1" aria-label="Navegación móvil">
      {menuItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'mobile-nav-link rounded-lg px-3.5 py-2.5 text-sm font-medium transition-colors duration-200 cursor-pointer',
            item.active
              ? 'bg-red-50 font-semibold text-[#B91C1C]'
              : 'text-[#6B5B57] hover:bg-slate-50 hover:text-[#B91C1C]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="mt-4 border-t border-slate-100 pt-4">
      <a
        href={demoWhatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-[#B80D14] px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-colors duration-200 hover:bg-[#990B11] cursor-pointer"
      >
        <span>Probar Demo</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileMenu && iconOpen && iconClose) {
    const toggleMenu = (forceClose = false) => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      const nextState = forceClose ? false : !isExpanded;

      toggleBtn.setAttribute('aria-expanded', String(nextState));
      mobileMenu.classList.toggle('hidden', !nextState);
      iconOpen.classList.toggle('hidden', nextState);
      iconClose.classList.toggle('hidden', !nextState);
    };

    toggleBtn.addEventListener('click', () => toggleMenu());
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => toggleMenu(true));
    });
  }

  import gsap from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', clearProps: 'all' } });
    tl.fromTo('.nav-brand', { y: -14, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.5 })
      .fromTo('.nav-item', { y: -10, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.4, stagger: 0.05 }, '-=0.3')
      .fromTo('.nav-cta', { y: -10, autoAlpha: 0, scale: 0.96 }, { y: 0, autoAlpha: 1, scale: 1, duration: 0.4 }, '-=0.25');
  }
</script>
