---
import { siteConfig, navLinks } from '../../data/siteData';
import Button from '../ui/Button.astro';
---

<header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="#inicio" class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-400 font-black text-slate-950">
        SP
      </span>
      <span>{siteConfig.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-300 transition-colors hover:text-amber-400"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <Button href="#contacto" variant="primary">Reservar Cupo</Button>
    </div>
  </div>
</header>
