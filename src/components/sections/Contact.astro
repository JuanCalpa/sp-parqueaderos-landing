---
import { siteConfig } from '../../data/siteData';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
---

<section id="contacto" class="py-20 border-t border-slate-900">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      badge="Contacto"
      title="¿Listo para asegurar tu cupo?"
      subtitle="Escríbenos para reservar mensualidades, convenios empresariales o atención al cliente."
    />

    <Card class="p-8">
      <div class="grid gap-8 md:grid-cols-2">
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-white">Información de contacto</h3>
          <p class="text-sm text-slate-400">
            Atendemos solicitudes corporativas y reservas de cupos mensuales de forma inmediata.
          </p>
          <div class="space-y-2 text-sm text-slate-300">
            <p><strong class="text-amber-400">Teléfono:</strong> {siteConfig.phone}</p>
            <p><strong class="text-amber-400">Email:</strong> {siteConfig.email}</p>
            <p><strong class="text-amber-400">Ubicación:</strong> {siteConfig.address}</p>
          </div>
        </div>

        <form class="space-y-4" onsubmit="return false;">
          <div>
            <label for="name" class="block text-xs font-medium text-slate-300">Nombre completo</label>
            <input
              id="name"
              type="text"
              placeholder="Tu nombre"
              class="mt-1 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
            />
          </div>
          <div>
            <label for="email" class="block text-xs font-medium text-slate-300">Correo o Teléfono</label>
            <input
              id="email"
              type="text"
              placeholder="correo@ejemplo.com"
              class="mt-1 w-full rounded-xl border border-slate-700 bg-slate-950 px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:border-amber-400 focus:outline-none"
            />
          </div>
          <Button variant="primary" class="w-full">Enviar Solicitud</Button>
        </form>
      </div>
    </Card>
  </div>
</section>
