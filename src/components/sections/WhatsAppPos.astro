---
const whatsappFeatures = [
  'Cero costo de papel, cartuchos o cabezales',
  'Recordatorios de mensualidad 5 días antes de vencer',
  'El cliente nunca pierde su comprobante',
];

const thermalFeatures = [
  'Compatible con impresoras térmicas USB, LAN y Serial',
  'Corte automático de papel al disparar salida',
  'Opción de reimpresión desde historial hasta 1 año',
];

const barcodeBars = [
  3, 1, 2, 1, 4, 1, 2, 2, 1, 3, 1, 2, 1, 1, 3, 2, 1, 4, 1, 2, 1, 3, 2, 1, 2, 1, 3, 1, 2, 4, 1, 2,
];
---

<section
  id="whatsapp-pos"
  class="w-full bg-[#F4F6FB] px-4 py-20 text-slate-900 sm:px-6 lg:px-8 border-t border-slate-200/70"
>
  <div class="mx-auto max-w-5xl">
    <!-- Header -->
    <div class="wp-header mx-auto max-w-2xl text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[#B80D14]">
        DUALIDAD DE EMISIÓN
      </p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl leading-tight">
        Elige o combina: Ticket Digital por WhatsApp o Impresión Térmica
      </h2>
      <p class="mt-3.5 text-sm sm:text-base leading-relaxed text-[#6B5B57]">
        Adáptate a cada conductor sin fricción. Puedes emitir tickets físicos tradicionales o enviar un mensaje automático oficial a su celular.
      </p>
    </div>

    <!-- Two Comparison Cards -->
    <div class="wp-grid mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 items-stretch">
      <!-- Card 1: WhatsApp Oficial Cloud API -->
      <div class="wp-card flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-7 shadow-sm transition-shadow duration-200 hover:shadow-md">
        <div>
          <!-- Card Title Row -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <!-- WhatsApp Bubble SVG -->
              <svg
                class="h-5 w-5 shrink-0 text-[#16A34A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>
              <h3 class="text-base font-extrabold text-[#15803D]">
                WhatsApp Oficial Cloud API
              </h3>
            </div>
            <span class="inline-flex items-center rounded-md bg-[#86EFAC]/70 px-2.5 py-1 text-[11px] font-bold text-[#14532D]">
              Meta Approved
            </span>
          </div>

          <!-- WhatsApp Message Mockup Box -->
          <div class="wp-ticket-box mt-5 rounded-xl border border-[#BBF7D0] bg-[#E8F8EE] p-4 sm:p-5">
            <div class="flex items-center gap-1.5 text-xs font-extrabold tracking-wide text-[#15803D]">
              <svg
                class="h-4 w-4 shrink-0 text-[#16A34A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="m9 12 2 2 4-4" />
              </svg>
              <span>SP PARQUEADEROS - TICKET DIGITAL</span>
            </div>

            <p class="mt-2 text-xs font-medium text-slate-700">
              Este es tu ticket de parqueadero
            </p>

            <!-- White Inner Data Table -->
            <div class="mt-3 rounded-lg bg-white p-3.5 font-mono text-xs shadow-2xs space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">ID TICKET:</span>
                <span class="font-bold text-slate-900">SPP-7F4C2A</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">PARQUEADERO:</span>
                <span class="text-slate-800">Parqueadero Centro Norte</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">NOMBRE:</span>
                <span class="text-slate-800">Carlos Mendoza</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">CÉDULA:</span>
                <span class="font-bold text-[#16A34A]">1020458912</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">LUGAR:</span>
                <span class="text-slate-800">A14</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">PLACA:</span>
                <span class="font-bold text-[#DC2626]">KLM 482</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="font-semibold text-slate-700">FECHA Y HORA:</span>
                <span class="text-slate-800">15/10/2026 9:15AM</span>
              </div>
            </div>

            <div class="mt-3 flex items-center justify-between text-[11px] font-medium text-slate-600">
              <span class="inline-flex items-center gap-1.5 font-semibold text-[#15803D]">
                SP parqueaderos
              </span>
              <span class="text-slate-500">9:15 a. m.</span>
            </div>
          </div>
        </div>

        <!-- Bottom Checklist -->
        <ul class="mt-6 space-y-2.5 text-xs sm:text-sm text-slate-600">
          {whatsappFeatures.map((item) => (
            <li class="wp-check-item flex items-center gap-2.5">
              <svg
                class="h-4 w-4 shrink-0 text-[#16A34A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Card 2: Impresión Térmica 80mm -->
      <div class="wp-card flex flex-col justify-between rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-7 shadow-sm transition-shadow duration-200 hover:shadow-md">
        <div>
          <!-- Card Title Row -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <!-- Printer SVG -->
              <svg
                class="h-5 w-5 shrink-0 text-[#B80D14]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                <path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6" />
                <rect x="6" y="14" width="12" height="8" rx="1" />
              </svg>
              <h3 class="text-base font-extrabold text-[#B80D14]">
                Impresión Térmica 80mm
              </h3>
            </div>
            <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-700">
              ESC/POS
            </span>
          </div>

          <!-- Thermal Receipt Mockup Box -->
          <div class="wp-ticket-box mt-5 rounded-xl border border-slate-200/90 bg-white p-5 font-mono text-slate-900 shadow-inner">
            <div class="text-center">
              <p class="text-base font-extrabold tracking-widest text-slate-950">
                SP PARQUEADEROS
              </p>
              <p class="mt-0.5 text-xs font-bold text-slate-900">
                Parqueadero Centro Norte
              </p>
              <p class="text-[11px] text-slate-700">
                Cra 45 # 104 - 22 El Prado
              </p>
            </div>

            <div class="my-2.5 border-t border-dashed border-slate-400"></div>

            <p class="text-center text-xs tracking-wider text-slate-800">
              TICKET DE ENTRADA
            </p>

            <!-- Plate Box -->
            <div class="my-2.5 border-2 border-slate-950 py-2 text-center">
              <span class="text-2xl font-extrabold tracking-widest text-slate-950">
                KLM 482
              </span>
            </div>

            <!-- Ticket Key-Value Rows -->
            <div class="space-y-1 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Fecha</span>
                <span class="font-bold text-slate-950">15/10/2026</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Hora de entrada</span>
                <span class="font-bold text-slate-950">09:15</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Tipo</span>
                <span class="font-bold text-slate-950">Carro Normal</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Lugar</span>
                <span class="font-bold text-slate-950">A14</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Tablero llaves</span>
                <span class="font-bold text-slate-950">T04</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Conductor</span>
                <span class="font-bold text-slate-950">Carlos Mendoza</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-slate-700">Cédula</span>
                <span class="font-bold text-slate-950">1020458912</span>
              </div>
            </div>

            <div class="my-2.5 border-t border-dashed border-slate-400"></div>

            <p class="text-center text-[11px] leading-relaxed text-slate-800">
              Primera hora $2.500 · hora adicional<br />
              $2.500
            </p>

            <div class="my-2.5 border-t border-dashed border-slate-400"></div>

            <div class="text-center text-[11px] leading-relaxed text-slate-800">
              <p>Conserve este ticket y preséntelo al</p>
              <p>retirar su vehículo.</p>
              <p class="mt-1.5 text-xs text-slate-900">Ticket SPP-7F4C2A</p>
            </div>
          </div>
        </div>

        <!-- Bottom Checklist -->
        <ul class="mt-6 space-y-2.5 text-xs sm:text-sm text-slate-600">
          {thermalFeatures.map((item) => (
            <li class="wp-check-item flex items-center gap-2.5">
              <svg
                class="h-4 w-4 shrink-0 text-[#16A34A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    gsap.fromTo(
      '#whatsapp-pos .wp-header > *',
      { y: 24, autoAlpha: 0 },
      {
        scrollTrigger: {
          trigger: '#whatsapp-pos',
          start: 'top 92%',
          once: true,
        },
        y: 0,
        autoAlpha: 1,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
        clearProps: 'all',
      }
    );

    gsap.fromTo(
      '#whatsapp-pos .wp-card',
      { y: 36, autoAlpha: 0 },
      {
        scrollTrigger: {
          trigger: '#whatsapp-pos',
          start: 'top 88%',
          once: true,
        },
        y: 0,
        autoAlpha: 1,
        duration: 0.7,
        stagger: 0.16,
        ease: 'power3.out',
        clearProps: 'all',
      }
    );

    gsap.fromTo(
      '#whatsapp-pos .wp-ticket-box',
      { scale: 0.96, autoAlpha: 0 },
      {
        scrollTrigger: {
          trigger: '#whatsapp-pos',
          start: 'top 85%',
          once: true,
        },
        scale: 1,
        autoAlpha: 1,
        duration: 0.6,
        delay: 0.15,
        stagger: 0.16,
        ease: 'back.out(1.4)',
        clearProps: 'all',
      }
    );

    gsap.fromTo(
      '#whatsapp-pos .wp-check-item',
      { x: -12, autoAlpha: 0 },
      {
        scrollTrigger: {
          trigger: '#whatsapp-pos',
          start: 'top 82%',
          once: true,
        },
        x: 0,
        autoAlpha: 1,
        duration: 0.45,
        stagger: 0.06,
        ease: 'power2.out',
        clearProps: 'all',
      }
    );
  }
</script>
