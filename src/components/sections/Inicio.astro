---
import PhoneMockup from '../ui/PhoneMockup.astro';

const highlights = [
  {
    title: 'Rápido y Fácil',
    subtitle: 'Check-in por placa',
    color: 'text-emerald-600',
    bg: 'bg-emerald-50 ring-emerald-200/60',
    icon: '<path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>',
  },
  {
    title: 'Meta Cloud API',
    subtitle: 'WhatsApp oficial',
    color: 'text-red-700',
    bg: 'bg-red-50 ring-red-200/60',
    icon: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M8 12h.01"/><path d="M12 12h.01"/><path d="M16 12h.01"/>',
  },
  {
    title: 'Casilleros & Llaves',
    subtitle: 'Hasta 2 cascos x moto',
    color: 'text-emerald-600',
    bg: 'bg-emerald-50 ring-emerald-200/60',
    icon: '<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>',
  },
];
---

<section id="inicio" class="relative isolate overflow-hidden bg-[#fafafb] text-slate-900">
  <!-- Fondos decorativos -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 left-1/4 h-[36rem] w-[36rem] rounded-full bg-rose-200/40 blur-3xl"></div>
    <div class="absolute right-[-10rem] top-1/3 h-[30rem] w-[30rem] rounded-full bg-emerald-200/40 blur-3xl"></div>
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 pb-16 pt-6 sm:px-6 lg:grid-cols-[1fr_1.12fr] lg:gap-10 lg:px-8 lg:pb-20 lg:pt-8">
    <!-- Columna texto -->
    <div class="inicio-text-col">
      <span class="inicio-anim inline-flex items-center gap-2 rounded-full bg-indigo-50 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-red-700 ring-1 ring-indigo-100 sm:text-[11px]">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-700"></span>
        Software multi-tenant de gestión de parqueaderos en la nube y app móvil
      </span>

      <h1 class="inicio-anim font-display mt-3.5 text-3xl font-bold leading-[1.12] tracking-tight text-slate-900 sm:text-4xl xl:text-[44px]">
        El control total de tu parqueadero,{" "}
        <span class="text-red-700 underline decoration-rose-300 decoration-[3px] underline-offset-[6px]">en tiempo real</span>{" "}
        desde la web y tu celular
      </h1>

      <p class="inicio-anim mt-4 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-[15px]">
        Optimiza la entrada y salida de vehículos en milisegundos, liquida tarifas al minuto exacto,
        gestiona mensualidades sin pérdida de días, arquea turnos ciegos y despacha tickets por
        WhatsApp Oficial de Meta o impresión térmica de 80mm.
      </p>

      <div class="inicio-anim mt-5 flex flex-wrap items-center gap-3">
        <a
          href="#tarifas"
          class="font-display inline-flex cursor-pointer items-center gap-2 rounded-md bg-red-700 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-red-700/25 transition-colors duration-200 hover:bg-red-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-700 focus-visible:ring-offset-2"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 17V7h4a3 3 0 0 1 0 6H9" /></svg>
          Comenzar Ahora – Crear Parqueadero
        </a>
        <a
          href="#modulos"
          class="font-display inline-flex cursor-pointer items-center gap-2 rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-slate-200/70 transition-colors duration-200 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-700"
        >
          <svg class="h-4 w-4 text-red-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="m10 8 6 4-6 4z" /></svg>
          Ver Demostración en Vivo
        </a>
      </div>

      <ul class="mt-7 grid max-w-xl grid-cols-1 gap-3 sm:grid-cols-3">
        {highlights.map((item) => (
          <li class="inicio-highlight flex items-center gap-3 rounded-xl bg-white/95 p-3 shadow-sm ring-1 ring-slate-200/80 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md sm:flex-col sm:items-start sm:gap-2.5">
            <span class:list={['flex h-9 w-9 shrink-0 items-center justify-center rounded-lg ring-1', item.bg]}>
              <svg class:list={['h-4 w-4', item.color]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon} />
            </span>
            <div class="min-w-0 leading-tight">
              <p class="font-display text-[13.5px] font-bold text-slate-900">{item.title}</p>
              <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-500">{item.subtitle}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna visual -->
    <div class="inicio-visual relative mx-auto mb-14 w-full max-w-xl sm:mb-16 lg:mb-10">
      <!-- Ventana de navegador -->
      <div class="inicio-browser overflow-hidden rounded-lg bg-slate-800 shadow-2xl shadow-slate-900/25 ring-1 ring-slate-900/10">
        <div class="flex items-center gap-3 px-4 py-2.5">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-red-500"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
            <span class="h-3 w-3 rounded-full bg-slate-200"></span>
          </div>
          <div class="mx-auto flex min-w-0 items-center gap-1.5 rounded bg-slate-900/70 px-3 py-1 font-mono text-[11px] text-slate-200">
            <svg class="h-3 w-3 shrink-0 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            <span class="truncate">https://sp-parqueaderos.com/</span>
          </div>
          <svg class="hidden h-4 w-4 shrink-0 text-slate-300 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" /><path d="M21 3v5h-5" /></svg>
        </div>
        <img
          src="/Inicio/CapturaDashboard.png"
          alt="Dashboard en tiempo real de SP Parqueaderos con vehículos adentro, ingresos, movimientos y mapa de ocupación"
          width="1258"
          height="880"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>

      <!-- Celular sobre la ventana web -->
      <PhoneMockup
        src="/Inicio/CapturaCobroMobile.png"
        alt="Ticket de cobro de salida en la app móvil con total liquidado y casilleros a reclamar"
        width={497}
        height={652}
        cropped={false}
        class="inicio-phone absolute -right-1 sm:-right-[3%] top-[54%] z-10 w-[38%] sm:w-[40%] min-w-[130px] sm:min-w-[150px] rotate-[3deg] drop-shadow-2xl"
      />
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out', clearProps: 'all' } });

    tl.fromTo(
      '#inicio .inicio-anim',
      { y: 24, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.65, stagger: 0.1 }
    )
      .fromTo(
        '#inicio .inicio-highlight',
        { y: 18, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.08 },
        '-=0.35'
      )
      .fromTo(
        '#inicio .inicio-browser',
        { x: 32, opacity: 0, scale: 0.97 },
        { x: 0, opacity: 1, scale: 1, duration: 0.75 },
        '-=0.65'
      )
      .fromTo(
        '#inicio .inicio-phone',
        { y: 36, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.65, ease: 'back.out(1.4)' },
        '-=0.45'
      );
  }
</script>
