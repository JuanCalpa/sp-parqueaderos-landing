---
type Tone = 'neutral' | 'danger' | 'success';

interface Modulo {
  title: string;
  description: string;
  icon: string;
  iconColor: string;
  tag: { text: string; icon: string; iconColor?: string; tone: Tone };
}

// Iconos lucide (paths inline)
const icons = {
  gauge: '<path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  receipt: '<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6"/><path d="M16 12h-6"/><path d="M16 16h-6"/><path d="M8 8h.01"/><path d="M8 12h.01"/><path d="M8 16h.01"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  register: '<rect width="16" height="10" x="4" y="11" rx="2"/><path d="M8 11V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v6"/><path d="M8 15h.01"/><path d="M12 15h.01"/><path d="M16 15h.01"/><path d="M8 18h8"/>',
  message: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  printer: '<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  alert: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  bell: '<path d="M10.27 21a2 2 0 0 0 3.46 0"/><path d="M22 8c0-2.3-.8-4.3-2-6"/><path d="M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33"/><path d="M4 2C2.8 3.7 2 5.7 2 8"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
  qr: '<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/>',
};

const modulos: Modulo[] = [
  {
    title: 'Entrada Ultrarrápida y Bahías',
    description:
      'Registro rápido y fácil en cabina o patio. Soporta Carros, Motos, Camiones de Carga y Bicicletas. Asignación inmediata de celda disponible con visualización en tiempo real.',
    icon: icons.gauge,
    iconColor: 'text-red-700',
    tag: { text: 'Custodia de hasta 2 cascos por motocicleta', icon: icons.check, iconColor: 'text-emerald-700', tone: 'neutral' },
  },
  {
    title: 'Salida Inteligente y Liquidación',
    description:
      'Búsqueda instantánea por placa. Algoritmo tarifario estricto: primera hora completa, minutos fraccionales proporcionales y topes diarios de 24 horas sin desfase.',
    icon: icons.receipt,
    iconColor: 'text-emerald-700',
    tag: { text: 'Alerta obligatoria: Cascos y Llaves entregadas', icon: icons.alert, tone: 'danger' },
  },
  {
    title: 'Mensualidades y Cobranza',
    description:
      'Detección de placa activa con tarifa $0 automática. Renovación anticipada sumando desde el día de corte sin que el cliente pierda días de servicio.',
    icon: icons.calendar,
    iconColor: 'text-blue-600',
    tag: { text: 'Recordatorio WhatsApp 5 días antes de corte', icon: icons.bell, iconColor: 'text-red-600', tone: 'neutral' },
  },
  {
    title: 'Arqueo y Cuadre de Caja',
    description:
      'Apertura y cierre estricto de turno con control de base inicial. Discriminación transparente entre efectivo recaudado y pagos digitales (Nequi, Daviplata, Tarjetas).',
    icon: icons.register,
    iconColor: 'text-slate-700',
    tag: { text: 'Auditoría de aperturas e inconsistencias', icon: icons.shield, iconColor: 'text-emerald-700', tone: 'neutral' },
  },
  {
    title: 'Ticket WhatsApp Meta Homologado',
    description:
      'Envío instantáneo del tiquete de ingreso con plantilla oficial verificada por Meta (<code class="font-mono text-[13px] font-semibold text-slate-700">ticket_sp_parqueaderos</code>). Cero gasto en papel y mayor comodidad.',
    icon: icons.message,
    iconColor: 'text-emerald-700',
    tag: { text: 'Ahorro de hasta un 65% en insumos de rollo', icon: icons.leaf, tone: 'success' },
  },
  {
    title: 'Impresión Térmica 80mm / 58mm',
    description:
      'Protocolo de disparo automático ESC/POS para impresoras USB, de Red o Bluetooth. Generación de código QR y de barras para re-escaneo veloz a la salida.',
    icon: icons.printer,
    iconColor: 'text-red-700',
    tag: { text: 'Código QR y de barras de alta legibilidad', icon: icons.qr, iconColor: 'text-slate-700', tone: 'neutral' },
  },
];

const toneStyles: Record<Tone, string> = {
  neutral: 'bg-indigo-50/70 text-slate-800',
  danger: 'bg-red-100 text-red-700',
  success: 'bg-green-300/80 text-emerald-800',
};
---

<section id="modulos" class="bg-[#fafafb] py-20 text-slate-900 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="modulos-header flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div>
        <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-red-700">
          <span class="h-0.5 w-3 bg-red-700" aria-hidden="true"></span>
          Módulos de alto rendimiento
        </p>
        <h2 class="font-display mt-2 text-2xl font-semibold tracking-tight text-slate-900 sm:text-[26px]">
          Ingeniería de software para operaciones de flujo continuo
        </h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-slate-600">
        Diseñado bajo especificaciones de tráfico pesado: control de llaves, verificación de cascos,
        cálculo tarifario por fracción de minuto y auditoría contra fraude en taquilla.
      </p>
    </div>

    <!-- Tarjetas -->
    <ul class="modulos-grid mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {modulos.map((m) => (
        <li class="modulo-card flex flex-col rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200/60 transition-shadow duration-200 hover:shadow-md">
          <span class="flex h-12 w-12 items-center justify-center rounded-md bg-indigo-50">
            <svg class:list={['h-6 w-6', m.iconColor]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.icon} />
          </span>
          <h3 class="font-display mt-4 text-lg font-semibold text-slate-900">{m.title}</h3>
          <p class="mt-1.5 flex-1 text-sm leading-relaxed text-slate-600" set:html={m.description} />
          <p class:list={['mt-5 flex items-center gap-1.5 rounded px-2.5 py-1.5 text-[11px] font-semibold', toneStyles[m.tag.tone]]}>
            <svg class:list={['h-3.5 w-3.5 shrink-0', m.tag.iconColor]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={m.tag.icon} />
            {m.tag.text}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    gsap.fromTo(
      '#modulos .modulos-header > *',
      { y: 24, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.12,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#modulos',
          start: 'top 90%',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '#modulos .modulo-card',
      { y: 32, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.65,
        stagger: 0.1,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#modulos .modulos-grid',
          start: 'top 88%',
          once: true,
        },
      }
    );
  }
</script>
