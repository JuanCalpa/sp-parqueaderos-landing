---
import { pricingPlans, siteConfig } from '../../data/siteData';
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';

const whatsappNumber = siteConfig.phone.replace(/[^0-9]/g, '');

const vehicleRates = [
  {
    vehicle: 'Automóviles y Camionetas',
    minuteRate: '$95 / min',
    hourRate: '$4.500 / hora',
    dayCap: '$28.000 tarifa plena (12h)',
    monthly: '$220.000 / mes',
  },
  {
    vehicle: 'Motocicletas',
    minuteRate: '$65 / min',
    hourRate: '$3.000 / hora',
    dayCap: '$18.000 tarifa plena (12h)',
    monthly: '$130.000 / mes',
  },
  {
    vehicle: 'Bicicletas y Patinetas',
    minuteRate: '$10 / min',
    hourRate: '$600 / hora',
    dayCap: '$4.000 tarifa plena (12h)',
    monthly: '$35.000 / mes',
  },
];
---

<section id="tarifas" class="py-20 border-t border-slate-900 bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      badge="Planes y Tarifas Transparentes"
      title="Elige el plan ideal para tu vehículo o empresa"
      subtitle="Sin cobros ocultos. Tarifas reguladas con facturación electrónica, vigilancia CCTV 24/7 y póliza de respaldo."
    />

    <!-- Pricing Cards -->
    <div class="grid gap-8 lg:grid-cols-3 items-stretch">
      {pricingPlans.map((plan) => {
        const waUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola SP Parqueaderos, me interesa el plan: ${plan.name} (${plan.price}).`)}`;

        return (
          <div
            class:list={[
              'relative flex flex-col justify-between rounded-2xl border p-7 backdrop-blur-sm transition-all duration-200',
              plan.highlighted
                ? 'border-amber-400 bg-slate-900/95 shadow-xl shadow-amber-400/10 ring-1 ring-amber-400/40'
                : 'border-slate-800 bg-slate-900/60 hover:border-slate-700 hover:shadow-lg',
            ]}
          >
            {plan.highlighted && (
              <div class="absolute -top-3.5 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-400 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-slate-950 shadow-md">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" clip-rule="evenodd" />
                  </svg>
                  Más Elegido
                </span>
              </div>
            )}

            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-xl font-bold text-white">{plan.name}</h3>
                {plan.highlighted ? (
                  <Badge text="Ahorra hasta 35%" />
                ) : null}
              </div>

              <div class="mt-5 flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-extrabold tracking-tight text-amber-400">
                  {plan.price}
                </span>
                <span class="text-xs font-medium uppercase tracking-wider text-slate-400">
                  / {plan.period}
                </span>
              </div>

              <p class="mt-3 text-sm leading-relaxed text-slate-300">
                {plan.description}
              </p>

              <hr class="my-6 border-slate-800" />

              <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
                Incluye:
              </p>
              <ul class="mt-4 space-y-3 text-sm text-slate-200">
                {plan.features.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class="mt-0.5 h-5 w-5 shrink-0 text-emerald-400"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 pt-2">
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold transition-colors duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-400/60',
                  plan.highlighted
                    ? 'bg-amber-400 text-slate-950 hover:bg-amber-300 shadow-lg shadow-amber-400/20'
                    : 'border border-slate-700 bg-slate-800/70 text-white hover:border-amber-400 hover:text-amber-400',
                ]}
              >
                <span>Solicitar por WhatsApp</span>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Vehicle Rate Comparison Table -->
    <div class="mt-16 rounded-2xl border border-slate-800 bg-slate-900/50 p-6 sm:p-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center mb-6">
        <div>
          <h3 class="text-lg font-bold text-white">Tabla de Tarifas por Tipo de Vehículo</h3>
          <p class="mt-1 text-sm text-slate-400">
            Consulta los valores de referencia por minuto, hora, día completo o mensualidad.
          </p>
        </div>
        <span class="inline-flex items-center gap-2 self-start rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-300 sm:self-auto">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
          </svg>
          Tarifas con IVA y Póliza Incluida
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 text-xs font-semibold uppercase tracking-wider text-slate-400">
              <th class="py-3.5 px-4">Tipo de Vehículo</th>
              <th class="py-3.5 px-4">Fracción / Minuto</th>
              <th class="py-3.5 px-4">Valor Hora</th>
              <th class="py-3.5 px-4">Tarifa Plena (12h)</th>
              <th class="py-3.5 px-4 text-amber-400">Mensualidad 24/7</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/70 text-sm">
            {vehicleRates.map((row) => (
              <tr class="transition-colors duration-150 hover:bg-slate-800/40">
                <td class="py-4 px-4 font-semibold text-white">{row.vehicle}</td>
                <td class="py-4 px-4 text-slate-300">{row.minuteRate}</td>
                <td class="py-4 px-4 text-slate-300">{row.hourRate}</td>
                <td class="py-4 px-4 text-slate-300">{row.dayCap}</td>
                <td class="py-4 px-4 font-bold text-amber-400">{row.monthly}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
