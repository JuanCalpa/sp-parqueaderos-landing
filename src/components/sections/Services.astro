---
import { services } from '../../data/siteData';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
---

<section id="servicios" class="py-20 border-t border-slate-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      badge="Nuestros Servicios"
      title="Soluciones de estacionamiento a tu medida"
      subtitle="Desde parqueo por horas hasta operación integral de estacionamientos corporativos."
    />

    <div class="grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <Card class="flex flex-col justify-between">
          <div>
            <div class="mb-4">
              <Badge text={service.badge} />
            </div>
            <h3 class="text-xl font-bold text-white">{service.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-400">{service.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
