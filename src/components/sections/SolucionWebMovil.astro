---
import PhoneMockup from '../ui/PhoneMockup.astro';

const securityPoints = [
  {
    text: 'Aislamiento por Tenant ID validado a nivel de base de datos',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    text: 'Sesiones cifradas y auditoría inmutable de todas las acciones',
    icon: '<rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  },
  {
    text: 'Control de acceso basado en roles con privilegios mínimos',
    icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  },
];

const roles = [
  {
    n: '01',
    code: 'OWNER',
    title: 'Propietario',
    description:
      'Control supremo del negocio. Modificación de esquemas tarifarios, creación de sedes, arqueos consolidados, métricas y auditoría forense.',
    footer: 'Privilegios Totales 100%',
    border: 'border-t-red-700',
    badge: 'bg-red-50 text-red-700',
    accent: 'text-red-700',
  },
  {
    n: '02',
    code: 'ADMIN',
    title: 'Administrador',
    description:
      'Gestión operativa del día a día: cancelación y ajuste de mensualidades, reportes de recaudación, tarifas temporales y control de anomalías.',
    footer: 'Operación & Reportes',
    border: 'border-t-blue-700',
    badge: 'bg-blue-50 text-blue-700',
    accent: 'text-blue-700',
  },
  {
    n: '03',
    code: 'CASHIER',
    title: 'Cajero / Operador',
    description:
      'Velocidad pura en cabina: registro de entradas, asignación de bahías y casilleros, liquidación, cobro y apertura/cierre de su propia caja.',
    footer: 'Operación en Cabina',
    border: 'border-t-emerald-700',
    badge: 'bg-emerald-50 text-emerald-700',
    accent: 'text-emerald-700',
  },
];
---

<!-- Arquitectura omnicanal: cabina + móvil -->
<section id="solucion" class="bg-[#f5f5fa] py-16 text-slate-900 sm:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="solucion-header mx-auto max-w-3xl text-center">
      <p class="text-[11px] font-semibold uppercase tracking-wider text-red-700">Arquitectura omnicanal</p>
      <h2 class="font-display mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-[34px] sm:leading-tight">
        Diseñado para la velocidad en cabina y el control en movimiento
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-[15px] leading-relaxed text-slate-600">
        SP Parqueaderos sincroniza instantáneamente el terminal físico de cabina con los celulares de los
        operadores y el panel administrativo del dueño.
      </p>
    </div>

    <div class="solucion-grid mt-12 grid items-center gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-10">
      <!-- Terminal de cabina -->
      <div class="solucion-terminal">
        <div class="overflow-hidden rounded-xl bg-slate-800 p-1 shadow-2xl shadow-slate-900/20">
          <div class="relative flex items-center px-3 py-2">
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-slate-200"></span>
            </div>
            <p class="absolute left-1/2 -translate-x-1/2 font-mono text-[11px] font-semibold text-white">
              Consola de Cabina · Terminal POS
            </p>
            <svg class="ml-auto h-4 w-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" /></svg>
          </div>
          <div class="rounded-lg bg-[#eef1f6] p-2">
            <img
              src="/SolucionWebMovil/auditoria.png"
              alt="Consola de cabina con la actividad reciente: placas, tipo de vehículo, hora de entrada, slot, llaves y valor"
              width="1581"
              height="404"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </div>
        </div>
        <p class="mt-4 flex gap-2.5 text-[13px] leading-snug text-slate-600">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-red-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="M6 12h2l2-3 3 6 2-3h3" /></svg>
          <span><strong class="font-semibold text-slate-900">Terminal Fijo de Alto Tráfico:</strong> Ideal para pantallas táctiles de cabina y monitores de vigilancia. Permite atajos de teclado para registro sin tocar el mouse.</span>
        </p>
      </div>

      <!-- Celulares -->
      <div class="solucion-phones">
        <div class="flex items-start justify-center gap-4 sm:gap-5">
          <div class="w-1/2 max-w-[230px]">
            <p class="mb-2 text-center text-[11px] font-semibold uppercase tracking-wider text-red-700">Paso 1: Entrada</p>
            <PhoneMockup
              src="/SolucionWebMovil/entrada.png"
              alt="App móvil, paso de entrada: tipo de vehículo, placa escaneada y mensualidad detectada"
              width={381}
              height={331}
              cropped={false}
            />
          </div>
          <div class="w-1/2 max-w-[230px] sm:-mt-3">
            <p class="mb-2 text-center text-[11px] font-semibold uppercase tracking-wider text-emerald-700">Paso 2: Liquidación</p>
            <PhoneMockup
              src="/SolucionWebMovil/salida.png"
              alt="App móvil, paso de liquidación: método de pago, cambio a devolver y confirmación de salida"
              width={380}
              height={382}
              cropped={false}
            />
          </div>
        </div>
        <p class="mt-6 flex gap-2.5 text-[13px] leading-snug text-slate-600">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2" ry="2" /><path d="M12 18h.01" /></svg>
          <span><strong class="font-semibold text-slate-900">Operación Móvil Dinámica:</strong> Valida ingresos a pie en la fila de vehículos, despeja cuellos de botella en horas pico y autoriza salidas desde cualquier punto del patio.</span>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Seguridad multi-inquilino y roles -->
<section id="seguridad" class="bg-white py-16 text-slate-900 sm:py-20">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1.4fr] lg:px-8">
    <div class="seguridad-info">
      <p class="inline-flex items-center gap-1.5 rounded bg-indigo-50 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-red-700">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" /><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" /><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" /><path d="M10 6h4" /><path d="M10 10h4" /><path d="M10 14h4" /><path d="M10 18h4" /></svg>
        Aislamiento criptográfico
      </p>
      <h2 class="font-display mt-4 text-2xl font-semibold leading-tight tracking-tight text-slate-900 sm:text-[26px]">
        Arquitectura Multi-Inquilino Segura: Tus datos son exclusivamente tuyos
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-slate-600">
        A diferencia de sistemas antiguos que comparten tablas planas, cada parqueadero opera como una entidad
        lógicamente aislada con credenciales protegidas con BCrypt y verificación de permisos por token en cada
        microservicio Spring Boot.
      </p>
      <ul class="mt-4 space-y-2.5">
        {securityPoints.map((p) => (
          <li class="flex items-center gap-2.5 text-[13px] text-slate-700">
            <svg class="h-4 w-4 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
            {p.text}
          </li>
        ))}
      </ul>
    </div>

    <ul class="seguridad-roles grid gap-3 sm:grid-cols-3">
      {roles.map((r) => (
        <li class:list={['seguridad-role-card flex flex-col rounded-lg border-t-4 bg-white p-4 shadow-sm ring-1 ring-slate-200/70', r.border]}>
          <div class="flex items-center justify-between">
            <span class:list={['flex h-8 w-8 items-center justify-center rounded-full text-xs font-bold', r.badge]}>{r.n}</span>
            <span class:list={['font-mono text-[11px] font-semibold', r.accent]}>{r.code}</span>
          </div>
          <h3 class="font-display mt-4 text-base font-semibold text-slate-900">{r.title}</h3>
          <p class="mt-1.5 flex-1 text-[12px] leading-relaxed text-slate-600">{r.description}</p>
          <p class:list={['mt-4 text-[11px] font-semibold', r.accent]}>{r.footer}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    gsap.fromTo(
      '#solucion .solucion-header > *',
      { y: 24, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.1,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#solucion',
          start: 'top 90%',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '#solucion .solucion-terminal',
      { x: -32, opacity: 0 },
      {
        x: 0,
        opacity: 1,
        duration: 0.7,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#solucion .solucion-grid',
          start: 'top 86%',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '#solucion .solucion-phones',
      { x: 32, opacity: 0 },
      {
        x: 0,
        opacity: 1,
        duration: 0.7,
        delay: 0.15,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#solucion .solucion-grid',
          start: 'top 86%',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '#seguridad .seguridad-info > *',
      { y: 20, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#seguridad',
          start: 'top 90%',
          once: true,
        },
      }
    );

    gsap.fromTo(
      '#seguridad .seguridad-role-card',
      { y: 30, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.65,
        stagger: 0.14,
        ease: 'power3.out',
        clearProps: 'all',
        scrollTrigger: {
          trigger: '#seguridad .seguridad-roles',
          start: 'top 88%',
          once: true,
        },
      }
    );
  }
</script>
