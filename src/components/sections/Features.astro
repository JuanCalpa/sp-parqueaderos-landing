---
import { features } from '../../data/siteData';
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
---

<section id="beneficios" class="py-20 bg-slate-900/30 border-t border-slate-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      badge="Por qué elegirnos"
      title="Tecnología y respaldo en cada espacio"
      subtitle="Diseñamos una experiencia de parqueo rápida, cómoda y monitoreada en todo momento."
    />

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((feature) => (
        <Card>
          <h3 class="text-lg font-semibold text-amber-400">{feature.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{feature.description}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
