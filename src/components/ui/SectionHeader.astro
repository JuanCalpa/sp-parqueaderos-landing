---
import Badge from './Badge.astro';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
}

const { badge, title, subtitle } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center mb-12">
  {badge && <div class="mb-3"><Badge text={badge} /></div>}
  <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-base text-slate-400">{subtitle}</p>}
</div>
