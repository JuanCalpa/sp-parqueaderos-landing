---
/**
 * Marco de iPhone (estilo Dynamic Island) basado en el mockup "phone-mockups-1" de 21st.dev,
 * reescrito en Astro + Tailwind (sin React). Con `cropped` el teléfono se corta por la mitad
 * inferior con un desvanecido, ideal para capturas que solo cubren media pantalla.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  cropped?: boolean;
  class?: string;
}

const { src, alt, width, height, cropped = true, class: className = '' } = Astro.props;

const fadeMask =
  'mask-image: linear-gradient(to bottom, #000 78%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);';
---

<!-- El contenedor externo recibe la posición desde fuera (absolute, top, right...) sin conflictos -->
<div class={className} style={cropped ? fadeMask : undefined}>
<div class="relative">
  <!-- Botones laterales -->
  <span class="absolute -left-[3px] top-24 h-8 w-[3px] rounded-l-md bg-slate-800" aria-hidden="true"></span>
  <span class="absolute -left-[3px] top-36 h-12 w-[3px] rounded-l-md bg-slate-800" aria-hidden="true"></span>
  <span class="absolute -right-[3px] top-32 h-16 w-[3px] rounded-r-md bg-slate-800" aria-hidden="true"></span>

  <!-- Cuerpo -->
  <div
    class:list={[
      'relative bg-slate-700 p-[9px] shadow-2xl shadow-slate-900/40 ring-1 ring-slate-800',
      cropped ? 'rounded-t-[2.75rem] pb-0' : 'rounded-[2.75rem]',
    ]}
  >
    <!-- Pantalla -->
    <div
      class:list={[
        'relative overflow-hidden bg-white',
        cropped ? 'rounded-t-[2.2rem]' : 'rounded-[2.2rem]',
      ]}
    >
      <!-- Barra de estado + Dynamic Island -->
      <div class="relative flex h-10 items-center justify-between px-6 font-mono text-[11px] font-semibold text-slate-900">
        <span>9:41</span>
        <span class="absolute left-1/2 top-2 h-6 w-[88px] -translate-x-1/2 rounded-full bg-black" aria-hidden="true">
          <span class="absolute right-3 top-1/2 h-2 w-2 -translate-y-1/2 rounded-full bg-neutral-800 ring-1 ring-neutral-700"></span>
        </span>
        <span class="flex items-center gap-1" aria-hidden="true">
          <svg viewBox="0 0 18 12" class="h-2.5 w-3.5 fill-current"><rect x="0" y="8" width="3" height="4" rx="1" /><rect x="5" y="5" width="3" height="7" rx="1" /><rect x="10" y="2.5" width="3" height="9.5" rx="1" /><rect x="15" y="0" width="3" height="12" rx="1" /></svg>
          <span class="relative inline-block h-[11px] w-[22px] rounded-[3px] border border-slate-900/80 p-[1.5px]">
            <span class="block h-full w-[85%] rounded-[1.5px] bg-slate-900"></span>
          </span>
        </span>
      </div>

      <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="block h-auto w-full" />
    </div>
  </div>
</div>
</div>
