---
import { siteConfig } from '../../data/siteData';

const whatsappNumber = siteConfig.phone.replace(/[^0-9]/g, '');
const defaultMessage = 'Hola SP Parqueaderos, me gustaría recibir información sobre cupos, tarifas y mensualidades.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<div class="fixed bottom-5 right-5 z-50 flex items-center gap-3">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chatear por WhatsApp con SP Parqueaderos"
    class="group flex items-center gap-2.5 rounded-full bg-emerald-500 px-4 py-3.5 text-white shadow-xl shadow-emerald-500/25 ring-2 ring-emerald-400/40 transition-colors duration-200 hover:bg-emerald-400 hover:text-slate-950 cursor-pointer focus:outline-none focus:ring-4 focus:ring-emerald-400/60"
  >
    <span class="relative flex h-6 w-6 items-center justify-center">
      <svg
        class="h-6 w-6 fill-current"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.126.556 4.122 1.534 5.854l-1.534 5.603 5.736-1.504c1.693.924 3.633 1.447 5.7 1.447 6.627 0 12-5.373 12-12s-5.373-12-11.436-11.4z" />
      </svg>
    </span>
    <span class="hidden text-sm font-bold sm:inline">
      ¿Necesitas cupo? Escríbenos
    </span>
  </a>
</div>
